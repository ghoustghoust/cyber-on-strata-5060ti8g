{
  "exe": "engine/strata.exe",
  "cwd": ".",
  "log": "logs/serve-engine.log",
  "tokenizer": "pack/iq-native/tokenizer",
  "model_name": "Cyber-Tiel-Coder-35B-A3B",
  "fit_max_tokens": true,
  "engine_silence_s": 0,
  "reasoning_budget_tokens": 4096,
  "args": [
    "--pack",
    "pack/iq-native",
    "--native",
    "models/Cyber-Tiel-Coder-35B-A3B-MTP-UD-Q4_K_XL.gguf",
    "--resident-experts",
    "--no-ple",
    "--expert-profile",
    "profile/expert-profile-40x256-trace-cur.bin",
    "--expert-profile-save",
    "profile/serve-learned.bin",
    "--expert-profile-save-every",
    "10",
    "--expert-cache",
    "auto",
    "--vram-reserve-mib",
    "1500",
    "--prefill",
    "2048",
    "--max-context",
    "32768",
    "--kv",
    "int8",
    "--spec",
    "2",
    "--suffix-draft",
    "0",
    "--mtp-max-t",
    "1",
    "--pool-workers",
    "0",
    "--pool-affinity",
    "auto",
    "--stats"
  ],
  "sampling": {
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0
  }
